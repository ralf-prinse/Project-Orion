from services.market_data.yahoo_historical_provider import (
    YahooHistoricalDataProvider,
)


def main():
    print("=== HISTORICAL DATA PROVIDER TEST ===")

    provider = YahooHistoricalDataProvider()

    symbols = [
        "AAPL",
        "MSFT",
        "TSLA",
    ]

    history = provider.get_history(
        symbols=symbols,
        period="6mo",
        interval="1d",
    )

    stats = provider.stats

    print(f"Provider: {stats.provider_name}")
    print(f"Gevraagd: {stats.requested_symbols}")
    print(f"Ontvangen: {stats.received_symbols}")
    print(f"Ontbrekend: {stats.missing_symbols}")
    print(f"Uit cache: {stats.cache_hits}")
    print(f"Nieuw opgehaald: {stats.fresh_downloads}")
    print(f"Duur: {stats.duration_seconds:.2f} sec")
    print()

    for symbol, dataframe in history.items():
        print(f"{symbol}: {len(dataframe)} candles")


if __name__ == "__main__":
    main()